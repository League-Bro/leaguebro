{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "League Bro",
  "version": "0.1.23",
  "identifier": "dev.dom.leaguebro",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://127.0.0.1:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/leaguebro/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "League Bro",
        "width": 1080,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "League Bro Overlay",
        "width": 340,
        "height": 460,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "shadow": false
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; img-src 'self' data: https://raw.communitydragon.org https://d28xe8vt774jo5.cloudfront.net; media-src https://d28xe8vt774jo5.cloudfront.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDQTNDQTYwQTAxQkM0QUIKUldTcnhCdWdZTXFqckcwRFFUY3hxdmgwclAvdFRZUGNsTXgwNUVQSUJ5RnExUzFOWGc3T2ptMmkK",
      "endpoints": [
        "https://github.com/doliaro/leaguebro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
