{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "League Buddy",
  "version": "0.1.1",
  "identifier": "dev.dom.leaguebuddy",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/leaguebuddy/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "League Buddy",
        "width": 1080,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "League Buddy Overlay",
        "width": 270,
        "height": 360,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://raw.communitydragon.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
